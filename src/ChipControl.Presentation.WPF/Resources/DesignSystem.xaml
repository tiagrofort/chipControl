<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         ChipControl Design System — baseado no Stitch.
         Cores, tipografia, raios e componentes compartilhados.
         ============================================================ -->

    <!-- ===================== CORES ===================== -->
    <Color x:Key="ColorPrimary">#004277</Color>
    <Color x:Key="ColorPrimaryContainer">#005A9E</Color>
    <Color x:Key="ColorOnPrimary">#FFFFFF</Color>
    <Color x:Key="ColorPrimaryFixed">#D3E4FF</Color>
    <Color x:Key="ColorOnPrimaryContainer">#B1D1FF</Color>
    <Color x:Key="ColorOnSurface">#191C20</Color>
    <Color x:Key="ColorOnSurfaceVariant">#414750</Color>
    <Color x:Key="ColorSurface">#F8F9FF</Color>
    <Color x:Key="ColorSurfaceContainerLow">#F2F3FA</Color>
    <Color x:Key="ColorSurfaceContainer">#ECEDF4</Color>
    <Color x:Key="ColorSurfaceContainerHigh">#E7E8EE</Color>
    <Color x:Key="ColorSurfaceVariant">#E1E2E8</Color>
    <Color x:Key="ColorSurfaceLowest">#FFFFFF</Color>
    <Color x:Key="ColorOutline">#727782</Color>
    <Color x:Key="ColorOutlineVariant">#C1C7D2</Color>
    <Color x:Key="ColorError">#BA1A1A</Color>
    <Color x:Key="ColorErrorContainer">#FFDAD6</Color>
    <Color x:Key="ColorOnErrorContainer">#93000A</Color>
    <Color x:Key="ColorHover">#F3F2F1</Color>
    <Color x:Key="ColorBorderRow">#EDEBE9</Color>
    <Color x:Key="ColorSuccessBg">#DFF6DD</Color>
    <Color x:Key="ColorSuccessFg">#107C10</Color>

    <!-- ===================== BRUSHES ===================== -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryContainer" Color="{StaticResource ColorPrimaryContainer}"/>
    <SolidColorBrush x:Key="BrushOnPrimary" Color="{StaticResource ColorOnPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryFixed" Color="{StaticResource ColorPrimaryFixed}"/>
    <SolidColorBrush x:Key="BrushOnSurface" Color="{StaticResource ColorOnSurface}"/>
    <SolidColorBrush x:Key="BrushOnSurfaceVariant" Color="{StaticResource ColorOnSurfaceVariant}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainerLow" Color="{StaticResource ColorSurfaceContainerLow}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainer" Color="{StaticResource ColorSurfaceContainer}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainerHigh" Color="{StaticResource ColorSurfaceContainerHigh}"/>
    <SolidColorBrush x:Key="BrushSurfaceVariant" Color="{StaticResource ColorSurfaceVariant}"/>
    <SolidColorBrush x:Key="BrushSurfaceLowest" Color="{StaticResource ColorSurfaceLowest}"/>
    <SolidColorBrush x:Key="BrushOutline" Color="{StaticResource ColorOutline}"/>
    <SolidColorBrush x:Key="BrushOutlineVariant" Color="{StaticResource ColorOutlineVariant}"/>
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="BrushErrorContainer" Color="{StaticResource ColorErrorContainer}"/>
    <SolidColorBrush x:Key="BrushOnErrorContainer" Color="{StaticResource ColorOnErrorContainer}"/>
    <SolidColorBrush x:Key="BrushHover" Color="{StaticResource ColorHover}"/>
    <SolidColorBrush x:Key="BrushBorderRow" Color="{StaticResource ColorBorderRow}"/>
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource ColorSuccessBg}"/>
    <SolidColorBrush x:Key="BrushSuccessFg" Color="{StaticResource ColorSuccessFg}"/>
<!-- ===================== TIPOGRAFIA ===================== -->
    <FontFamily x:Key="FontFamilyWorkSans">Work Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">JetBrains Mono, Consolas</FontFamily>

    <!-- Display (28px/600) -->
    <Style x:Key="TypoDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyWorkSans}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
    </Style>

    <!-- Headline (20px/600) -->
    <Style x:Key="TypoHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyWorkSans}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
    </Style>

    <!-- Title-md (16px/600) -->
    <Style x:Key="TypoTitleMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyWorkSans}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
    </Style>

    <!-- Body-md (13px/400) -->
    <Style x:Key="TypoBodyMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyWorkSans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
    </Style>

    <!-- Label-sm (12px/500, cor variante) -->
    <Style x:Key="TypoLabelSm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyWorkSans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
    </Style>

    <!-- Label de formulário (label-sm, acima do campo) -->
    <Style x:Key="FormLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyWorkSans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ===================== ESPAÇAMENTOS / RAIOS ===================== -->
    <CornerRadius x:Key="CornerRadiusSm">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusDefault">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>

    <!-- Espaçamentos (escala 4px) -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">16</Thickness>
    <Thickness x:Key="SpaceLg">24</Thickness>
    <Thickness x:Key="SpacePage">24</Thickness>

