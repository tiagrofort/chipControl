<Window x:Class="ChipControl.Presentation.WPF.Views.FuncionarioModalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funcionário" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{StaticResource BrushSurfaceLowest}"
            BorderBrush="{StaticResource BrushOutlineVariant}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusLg}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="16" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="{StaticResource SpaceLg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource TypoHeadline}"
                       Text="{Binding TituloModal}"
                       Margin="0,0,0,24"/>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Nome Completo" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding NomeCompleto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Label Content="Matrícula" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxInput}"
                                     Text="{Binding Matricula}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Label Content="Setor" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxInput}"
                                     Text="{Binding Setor, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Cargo" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding Cargo}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Telefone Pessoal" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding TelefonePessoal}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="E-mail" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding Email}"/>
                    </StackPanel>

                    <CheckBox Content="Ativo"
                              FontFamily="{StaticResource FontFamilyWorkSans}"
                              FontSize="13" FontWeight="Medium"
                              Foreground="{StaticResource BrushOnSurface}"
                              IsChecked="{Binding Ativo}"
                              VerticalAlignment="Center"
                              Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Observações" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}" Height="72"
                                 Text="{Binding Observacoes}"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BrushOutlineVariant}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource ButtonGhost}"
                            MinWidth="84" Margin="0,0,8,0"
                            Click="Cancelar_Click"/>
                    <Button Content="Salvar" Style="{StaticResource ButtonPrimary}"
                            MinWidth="84"
                            Click="Salvar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>