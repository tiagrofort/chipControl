<UserControl x:Class="ChipControl.Presentation.WPF.Views.PlaceholderView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="#FFFFFF" BorderBrush="#C1C7D2" BorderThickness="1"
                CornerRadius="8" Padding="24" Margin="24">
            <TextBlock TextWrapping="Wrap"
                       FontFamily="Work Sans"
                       FontSize="13"
                       Foreground="#414750">
                <Run FontWeight="SemiBold" Text="{Binding Titulo}"/> — em desenvolvimento.
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
