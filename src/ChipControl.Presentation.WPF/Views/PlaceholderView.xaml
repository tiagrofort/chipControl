<UserControl x:Class="ChipControl.Presentation.WPF.Views.PlaceholderView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrushSurface}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36"
                    Background="{StaticResource BrushSurfaceContainer}"
                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                    HorizontalAlignment="Center">
                <Path Data="{StaticResource IconSimCard}" Width="32" Height="32" Stretch="Uniform"
                      Fill="{StaticResource BrushPrimaryContainer}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource TypoHeadline}"
                       Text="{Binding Titulo, Mode=OneWay}"
                       HorizontalAlignment="Center" Margin="0,20,0,4"/>
            <TextBlock Style="{StaticResource TypoBodyMd}"
                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                       Text="Módulo em desenvolvimento."
                       HorizontalAlignment="Center"/>
            <Border Style="{StaticResource StatusPill}"
                    Background="{StaticResource BrushPrimaryFixed}"
                    Padding="12,5" Margin="0,16,0,0" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource TypoLabelSm}"
                           Foreground="{StaticResource BrushPrimaryContainer}"
                           Text="{Binding Titulo, Mode=OneWay}" FontSize="11"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
