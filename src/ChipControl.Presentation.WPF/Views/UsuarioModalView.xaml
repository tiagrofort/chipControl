<Window x:Class="ChipControl.Presentation.WPF.Views.UsuarioModalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuário" Height="540" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{StaticResource BrushSurfaceLowest}"
            BorderBrush="{StaticResource BrushOutlineVariant}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusLg}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="16" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="{StaticResource SpaceLg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource TypoHeadline}"
                       Text="{Binding TituloModal}"
                       Margin="0,0,0,24"/>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Nome" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Nome de Usuário" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16" x:Name="SenhaPanel">
                        <Label Content="Senha" Style="{StaticResource FormLabelStyle}"/>
                        <PasswordBox Name="SenhaBox" Style="{StaticResource PasswordBoxInput}"/>
                        <TextBlock Text="Deixe em branco para manter a senha atual."
                                   Style="{StaticResource TypoLabelSm}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Confirmar Senha" Style="{StaticResource FormLabelStyle}"/>
                        <PasswordBox Name="ConfirmarSenhaBox" Style="{StaticResource PasswordBoxInput}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="E-mail" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}"
                                 Text="{Binding Email}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Label Content="Nível de Acesso" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox Name="NivelCombo" Style="{StaticResource ComboBoxInput}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Content="Ativo"
                                  FontFamily="{StaticResource FontFamilyWorkSans}"
                                  FontSize="13" FontWeight="Medium"
                                  Foreground="{StaticResource BrushOnSurface}"
                                  IsChecked="{Binding Ativo}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Observações" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxInput}" Height="72"
                                 Text="{Binding Observacoes}"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BrushOutlineVariant}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource ButtonGhost}"
                            MinWidth="84" Margin="0,0,8,0"
                            Click="Cancelar_Click"/>
                    <Button Content="Salvar" Style="{StaticResource ButtonPrimary}"
                            MinWidth="84"
                            Click="Salvar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>