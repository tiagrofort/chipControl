<UserControl x:Class="ChipControl.Presentation.WPF.Views.DashboardView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource SpacePage}">

            <!-- KPI Section (4 cards principais) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>

                <!-- Total de SIMCARDs -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL DE SIMCARDS" Style="{StaticResource TypoLabelSm}"/>
                        <TextBlock Style="{StaticResource TypoDisplay}" Margin="0,8,0,0" Text="&#x2014;"/>
                        <TextBlock Text="Indicador a ser alimentado" Style="{StaticResource TypoLabelSm}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Em estoque -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="EM ESTOQUE" Style="{StaticResource TypoLabelSm}"/>
                        <TextBlock Style="{StaticResource TypoDisplay}" Margin="0,8,0,0" Text="&#x2014;"/>
                        <TextBlock Text="Prontos para uso" Style="{StaticResource TypoLabelSm}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Em uso particular -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="EM USO PARTICULAR" Style="{StaticResource TypoLabelSm}"/>
                        <TextBlock Style="{StaticResource TypoDisplay}" Margin="0,8,0,0" Text="&#x2014;"/>
                        <TextBlock Text="Linhas ativas" Style="{StaticResource TypoLabelSm}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- WhatsApp -->
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardBorder}" Padding="16" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="WHATSAPP" Style="{StaticResource TypoLabelSm}"/>
                        <TextBlock Style="{StaticResource TypoDisplay}" Margin="0,8,0,0" Text="&#x2014;"/>
                        <TextBlock Text="Linhas do WhatsApp" Style="{StaticResource TypoLabelSm}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Secondary KPIs (3 cards) -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16"
                        BorderBrush="{StaticResource BrushError}" BorderThickness="1,1,1,4">
                    <StackPanel>
                        <TextBlock Text="DANIFICADOS" Style="{StaticResource TypoLabelSm}"
                                   Foreground="{StaticResource BrushError}"/>
                        <TextBlock Style="{StaticResource TypoHeadline}" Margin="0,6,0,0"
                                   Text="&#x2014;" Foreground="{StaticResource BrushError}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PERDIDOS" Style="{StaticResource TypoLabelSm}"/>
                        <TextBlock Style="{StaticResource TypoHeadline}" Margin="0,6,0,0" Text="&#x2014;"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="NÃO DEVOLVIDOS" Style="{StaticResource TypoLabelSm}"/>
                        <TextBlock Style="{StaticResource TypoHeadline}" Margin="0,6,0,0" Text="&#x2014;"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Visão Geral de Status -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="VISÃO GERAL DE STATUS" Style="{StaticResource TypoLabelSm}" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource BrushSurfaceContainerLow}"
                            BorderBrush="{StaticResource BrushOutlineVariant}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusDefault}"
                            MinHeight="160">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBarChart}" Width="32" Height="32" Stretch="Uniform"
                                  Fill="{StaticResource BrushOutline}"
                                  HorizontalAlignment="Center"/>
                            <TextBlock Text="Área reservada para gráfico de evolução"
                                       Style="{StaticResource TypoLabelSm}"
                                       Foreground="{StaticResource BrushOutline}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
