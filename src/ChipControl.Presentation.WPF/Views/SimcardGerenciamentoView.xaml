<UserControl x:Class="ChipControl.Presentation.WPF.Views.SimcardGerenciamentoView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="clr-namespace:ChipControl.Presentation.WPF.ViewModels"
               xmlns:domain="clr-namespace:ChipControl.Domain.Enums;assembly=ChipControl.Domain">
    <Grid Margin="{StaticResource SpacePage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16"
                CornerRadius="{StaticResource CornerRadiusDefault}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Atualizar" Style="{StaticResource ButtonGhost}"
                            Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Content="+ Novo" Style="{StaticResource ButtonPrimary}"
                            Click="Novo_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{StaticResource BrushOnSurfaceVariant}"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="280"
                             Style="{StaticResource TextBoxSearch}"
                             VerticalAlignment="Center"
                             Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1" x:Name="SimcardsGrid"
                  ItemsSource="{Binding Simcards}"
                  SelectedItem="{Binding SimcardSelecionado}"
                  Style="{StaticResource DataGridChipControl}"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" SortMemberPath="Id"/>
                <DataGridTextColumn Header="Identificação Chip" Binding="{Binding IdentificacaoChip}" Width="*" SortMemberPath="IdentificacaoChip"/>
                <DataGridTextColumn Header="ICCID" Binding="{Binding Iccid}" Width="160" SortMemberPath="Iccid"/>
                <DataGridTextColumn Header="Operadora" Binding="{Binding OperadoraNome}" Width="130" SortMemberPath="OperadoraNome"/>
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}"/>
                                        <Setter Property="Padding" Value="8,2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="EmEstoque">
                                                <Setter Property="Background" Value="{StaticResource BrushSuccessBg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="WhatsApp">
                                                <Setter Property="Background" Value="{StaticResource BrushSuccessBg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="EmUsoParticular">
                                                <Setter Property="Background" Value="{StaticResource BrushPrimaryFixed}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Danificado">
                                                <Setter Property="Background" Value="{StaticResource BrushErrorContainer}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Perdido">
                                                <Setter Property="Background" Value="{StaticResource BrushErrorContainer}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="NaoDevolvido">
                                                <Setter Property="Background" Value="{StaticResource BrushErrorContainer}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Inativo">
                                                <Setter Property="Background" Value="{StaticResource BrushErrorContainer}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Descartado">
                                                <Setter Property="Background" Value="{StaticResource BrushOutlineVariant}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TypoLabelSm}">
                                            <Setter Property="Text" Value="{Binding StatusTexto}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="EmEstoque">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccessFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="WhatsApp">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccessFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="EmUsoParticular">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnPrimaryContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="Danificado">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnErrorContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="Perdido">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnErrorContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="NaoDevolvido">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnErrorContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="Inativo">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnErrorContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusTexto}" Value="Descartado">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ativo" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                        <Setter Property="Background" Value="{StaticResource BrushSuccessBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource BrushErrorContainer}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TypoLabelSm}">
                                            <Setter Property="Text" Value="Ativo"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccessFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                    <Setter Property="Text" Value="Inativo"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnErrorContainer}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ações" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Style="{StaticResource ButtonAction}"
                                        Margin="0,0,6,0" Click="Editar_Click" Tag="{Binding}"/>
                                <Button Content="Status" Style="{StaticResource ButtonAction}"
                                        Margin="0,0,6,0">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Em estoque" Tag="EmEstoque" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="Em uso particular" Tag="EmUsoParticular" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="WhatsApp" Tag="WhatsApp" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="Danificado" Tag="Danificado" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="Perdido" Tag="Perdido" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="Não devolvido" Tag="NaoDevolvido" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="Descartado" Tag="Descartado" Click="StatusMenuItem_Click"/>
                                            <MenuItem Header="Inativo" Tag="Inativo" Click="StatusMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="Ativar/Desativar" Style="{StaticResource ButtonAction}"
                                        Click="AlternarAtivo_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
