<Window x:Class="ChipControl.Presentation.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChipControl.Presentation.WPF.ViewModels"
        Title="Login - Controle de Chips"
        Width="420" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="#FFFFFFFF"
            BorderBrush="#C1C7D2"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="16" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="#F8F9FF">
                <Grid>
                    <Ellipse Width="160" Height="160" Fill="#D3E4FF" Opacity="0.4"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,0,-30,-30"/>
                    <Ellipse Width="120" Height="120" Fill="#B1D1FF" Opacity="0.3"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-30,-30,0,0"/>

                    <StackPanel Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Logo -->
                        <Border Width="56" Height="56"
                                Background="#005A9E" CornerRadius="8"
                                BorderBrush="#005A9E" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock Text="&#xE803;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="Controle de Chips"
                                   FontFamily="Work Sans"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="#191C20"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Acesso Seguro ao Sistema"
                                   FontFamily="Work Sans"
                                   FontSize="13"
                                   Foreground="#414750"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,32"/>

                        <!-- Username -->
                        <StackPanel Margin="0,0,0,16" Width="340">
                            <Label Content="Nome de Usuário"
                                   FontFamily="Work Sans"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#414750"
                                   Margin="0,0,0,4"/>
                            <TextBox Name="UsernameTextBox"
                                     FontFamily="Work Sans"
                                     FontSize="13"
                                     Height="40"
                                     Background="#FFFFFF"
                                     BorderBrush="#C1C7D2"
                                     BorderThickness="1"
                                     Padding="12,8"
                                     VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Margin="0,0,0,24" Width="340">
                            <Label Content="Senha"
                                   FontFamily="Work Sans"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#414750"
                                   Margin="0,0,0,4"/>
                            <PasswordBox Name="PasswordBox"
                                         FontFamily="Work Sans"
                                         FontSize="13"
                                         Height="40"
                                         Background="#FFFFFF"
                                         BorderBrush="#C1C7D2"
                                         BorderThickness="1"
                                         Padding="12,8"/>
                        </StackPanel>

                        <!-- Login Button -->
                        <Button Name="LoginButton"
                                Content="Entrar"
                                FontFamily="Work Sans"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Width="340" Height="40"
                                HorizontalAlignment="Center"
                                Background="#005A9E"
                                Foreground="#FFFFFF"
                                BorderBrush="#005A9E"
                                BorderThickness="1"
                                Padding="16,10"
                                Click="LoginButton_Click"
                                IsDefault="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#004277"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
