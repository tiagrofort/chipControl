<Window x:Class="ChipControl.Presentation.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Chips" Height="700" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushSurface}"
        FontFamily="{StaticResource FontFamilyWorkSans}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="24,0">
                <TextBlock DockPanel.Dock="Left" x:Name="HeaderTitleText"
                           Style="{StaticResource TypoHeadline}"
                           VerticalAlignment="Center" Text="Dashboard"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{StaticResource BrushSurfaceContainer}"
                            BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPerson}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource BrushOnSurfaceVariant}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TypoLabelSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushOnSurface}"
                                   Text="{Binding Usuario.Nome}"/>
                        <TextBlock Style="{StaticResource TypoLabelSm}" FontSize="11"
                                   Text="{Binding Usuario.NivelAcesso}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BrushSurfaceLowest}"
                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,16,16">
                    <TextBlock Style="{StaticResource TypoTitleMd}"
                               Foreground="{StaticResource BrushPrimaryContainer}"
                               FontWeight="SemiBold" Text="Controle de Chips"/>
                    <TextBlock Style="{StaticResource TypoLabelSm}" FontSize="11"
                               Text="SIM Management" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Usuário logado (rodapé) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorderRow}" BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{StaticResource BrushPrimaryFixed}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Usuario.Nome[0]}"
                                       FontFamily="{StaticResource FontFamilyWorkSans}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushPrimaryContainer}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TypoLabelSm}" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushOnSurface}"
                                       Text="{Binding Usuario.Nome}"/>
                            <TextBlock Style="{StaticResource TypoLabelSm}" FontSize="11"
                                       Text="{Binding Usuario.NivelAcesso}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navegação -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,0,8">
                        <Button x:Name="NavDashboard" Tag="Dashboard"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Dashboard_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDashboard}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSimcards" Tag="SIMCARDs"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Simcards_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSimCard}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="SIMCARDs" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavFuncionarios" Tag="Funcionários"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Funcionarios_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPeople}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Funcionários" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavOperadoras" Tag="Operadoras"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Operadoras_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDomain}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Operadoras" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAparelhos" Tag="Aparelhos"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Aparelhos_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPhone}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Aparelhos" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavTrocaNumeros" Tag="Troca de Números"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="TrocaNumeros_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSwapHoriz}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Troca de Números" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSubstituicao" Tag="Substituição"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Substituicao_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRestore}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Substituição" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavHistorico" Tag="Histórico"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Historico_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistory}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Histórico" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavRelatorios" Tag="Relatórios"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Relatorios_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBarChart}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Relatórios" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavUsuarios" Tag="Usuários"
                                Style="{StaticResource NavItemButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="Usuarios_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPeople}" Width="20" Height="20" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Usuários do Sistema" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== ÁREA DE CONTEÚDO ===================== -->
        <Frame Grid.Row="1" Grid.Column="1" x:Name="MainFrame"
               Background="{StaticResource BrushSurface}"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>