<Window x:Class="ChipControl.Presentation.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChipControl.Presentation.WPF.ViewModels"
        xmlns:local="clr-namespace:ChipControl.Presentation.WPF.Views"
        Title="Controle de Chips" Height="700" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFFFFF"
                BorderBrush="#E1E2E8" BorderThickness="0,0,0,1"
                Height="64">
            <DockPanel LastChildFill="True" Margin="24,0">
                <TextBlock DockPanel.Dock="Left"
                           FontFamily="Work Sans"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#004277"
                           VerticalAlignment="Center"
                           Text="Controle de Chips"/>
                <TextBlock DockPanel.Dock="Right"
                           FontFamily="Work Sans"
                           FontSize="13" FontWeight="Medium"
                           Foreground="#191C20"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap">
                    <Run Text="Bem-vindo, "/><Run Text="{Binding Usuario.Nome}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF"
                BorderBrush="#C1C7D2" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalContentAlignment="Top">
                <StackPanel Margin="0,16,0,0">
                    <Button Content="Dashboard"
                            FontFamily="Work Sans" FontSize="13" FontWeight="SemiBold"
                            Foreground="#004277" Background="#E6E2DF"
                            BorderBrush="#004277" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Dashboard_Click"/>
                    <Separator Margin="16,0,16,0" Background="#E1E2E8" Height="1"/>
                    <Button Content="SIMCARDs"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Simcards_Click"/>
                    <Button Content="Funcionários"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Funcionarios_Click"/>
                    <Button Content="Operadoras"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Operadoras_Click"/>
                    <Button Content="Aparelhos"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Aparelhos_Click"/>
                    <Button Content="Troca de Números"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="TrocaNumeros_Click"/>
                    <Button Content="Substituição"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Substituicao_Click"/>
                    <Button Content="Histórico"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Historico_Click"/>
                    <Button Content="Relatórios"
                            FontFamily="Work Sans" FontSize="13" FontWeight="400"
                            Foreground="#414750" Background="Transparent"
                            BorderBrush="#FFFFFF" BorderThickness="0,0,0,0"
                            Height="44" Padding="16,8" Click="Relatorios_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <Frame Grid.Row="1" Grid.Column="1" x:Name="MainFrame"
               Background="#F8F9FF"/>
    </Grid>
</Window>
